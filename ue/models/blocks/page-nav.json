{
  "definitions": [
    {
      "title": "Page Nav",
      "id": "page-nav",
      "model": "page-nav",
      "filter": "page-nav",
      "plugins": {
        "da": {
          "name": "page-nav",
          "rows": 0,
          "columns": 0
        }
      }
    },
    {
      "title": "Page Nav Item",
      "id": "page-nav-item",
      "model": "page-nav-item",
      "plugins": {
        "da": {
          "rows": 1,
          "columns": 2,
          "fields": [
            { "name": "label", "selector": "div:nth-child(1)" },
            { "name": "target", "selector": "div:nth-child(2)" }
          ]
        }
      }
    }
  ],
  "models": [
    {
      "id": "page-nav-item",
      "fields": [
        {
          "component": "text",
          "valueType": "string",
          "name": "label",
          "label": "Label",
          "required": true,
          "description": "The text shown in the sidebar (e.g. \"Resources\")."
        },
        {
          "component": "text",
          "valueType": "string",
          "name": "target",
          "label": "Target",
          "required": true,
          "description": "An in-page anchor like #helpful-resources (scrolls to the element with that id — headings get an id from their text, lowercased with hyphens), or a URL/path such as /onfi-savings-resources-and-support (opens that page)."
        }
      ]
    }
  ],
  "filters": [
    {
      "id": "page-nav",
      "components": [
        "page-nav-item"
      ]
    }
  ]
}
